# rex / n-dx serialize these outputs with LF line endings. Pin them to LF so
# the serializer's writes and git's checkout agree, and Windows CRLF checkouts
# (core.autocrlf=true) don't produce spurious line-ending churn in `git status`
# on every rex mutation. See https://github.com/en-dash-consulting/n-dx/issues/283
.rex/**/*.md    text eol=lf
.rex/**/*.json  text eol=lf
.rex/**/*.jsonl text eol=lf

# Same class: every other tracked file that n-dx tools write with LF
# (hench run records/config, sourcevision hints, ndx config, and the
# `ndx init`-generated assistant assets). Without a pin, re-running the
# tool on a Windows CRLF checkout shows line-ending-only churn.
.hench/**/*.md          text eol=lf
.hench/**/*.json        text eol=lf
.sourcevision/**/*.md   text eol=lf
.sourcevision/**/*.json text eol=lf
.sourcevision/**/*.txt  text eol=lf
.n-dx.json              text eol=lf
AGENTS.md               text eol=lf
CLAUDE.md               text eol=lf
.agents/**/*.md         text eol=lf
.claude/skills/**/*.md  text eol=lf
.codex/config.toml      text eol=lf

# repo-only eol pins (not injected by ndx init)
# Everything below is specific to this repository's own layout, so it is NOT
# part of GITATTRIBUTES_EOL_RULES (which `ndx init` writes into consumer
# projects). The sync guard in tests/e2e/prd-line-endings.test.js compares the
# injector list against the section ABOVE this marker only.
#
# A shebang line must end with LF. `#!/usr/bin/env node\r\n` breaks direct
# execution on Unix ("bad interpreter: ...^M") and breaks vitest's transform of
# any script a test imports, which fails collection with the locationless
# `SyntaxError: Invalid or unexpected token`. Every hashbang-bearing tracked
# file is already LF in the index, so these pins add no content change — they
# only stop Windows checkouts (core.autocrlf=true) from rewriting them to CRLF.
*.sh                        text eol=lf
*.mjs                       text eol=lf
*.py                        text eol=lf
packages/*/bin/*.js         text eol=lf
packages/*/src/cli/index.ts text eol=lf
packages/core/cli.js        text eol=lf
packages/core/export.js     text eol=lf

# PRD tree markdown merges through the rex-prd driver (three-way,
# frontmatter-aware). The driver is registered in git config by 'ndx init'.
.rex/prd_tree/** merge=rex-prd
