{
  "name": "@n-dx/graview-face",
  "version": "0.9.0",
  "description": "n-dx on Graview: the product layer, the changes, the code and the runs of an n-dx project as one graph, with a face in n-dx's own words. Depends on Graview and React; no other n-dx package depends on it.",
  "publishConfig": {
    "access": "public"
  },
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/en-dash-consulting/n-dx.git",
    "directory": "packages/graview-face"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ndx-graview-face": "./bin/serve.js"
  },
  "files": [
    "bin",
    "dev",
    "scripts/sync-data.mjs",
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "UPSTREAM.md"
  ],
  "scripts": {
    "sync": "node scripts/sync-data.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5189 --strictPort --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsc -p tsconfig.json && vitest run",
    "check": "graview check --document public/data/document.json",
    "doctor": "graview doctor",
    "types": "graview types ../graview/n-dx.graview.json --out src/model/types.ts",
    "fixture": "node scripts/make-fixture.mjs",
    "a11y": "node scripts/a11y.mjs",
    "look": "graview preview public/data/document.json --seed public/data/snapshot.json",
    "shots": "graview shots public/data/document.json --seed public/data/snapshot.json --out shots",
    "verify": "pnpm doctor && pnpm typecheck && pnpm test && pnpm build && pnpm check",
    "graview:link": "node scripts/graview.mjs link",
    "graview:npm": "node scripts/graview.mjs npm"
  },
  "dependencies": {
    "@graview/core": "0.1.26",
    "@graview/layout": "0.1.26",
    "@graview/pages": "0.1.26",
    "@graview/primitives": "0.1.26",
    "@graview/react": "0.1.26",
    "@graview/render": "0.1.26",
    "@graview/ship": "0.1.26",
    "@graview/tools": "0.1.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.1.1",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axe-core": "^4.10.2",
    "graview": "0.1.26",
    "playwright": "^1.64.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
