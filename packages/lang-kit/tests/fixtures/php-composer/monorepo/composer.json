{
    "name": "acme/shop",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "monolog/monolog": "^3.0",
        "acme/billing": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Acme\\Shop\\": ["src/", "./lib/shop/"],
            "Acme\\Shared\\": "shared"
        },
        "classmap": ["legacy/", "lib/Helpers.php"],
        "files": ["src/functions.php"],
        "exclude-from-classmap": ["legacy/tests/"]
    },
    "autoload-dev": {
        "psr-4": { "Acme\\Shop\\Tests\\": "tests/" }
    },
    "repositories": [
        { "type": "path", "url": "packages/*" },
        { "type": "vcs", "url": "https://example.com/acme/tools.git" },
        { "packagist.org": false }
    ],
    "config": { "vendor-dir": "lib/vendor" }
}
