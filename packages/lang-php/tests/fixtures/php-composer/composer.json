{
    "name": "acme/shop",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Acme\\Shop\\": ["src/", "lib/"]
        },
        "psr-0": {
            "Legacy_": "legacy/"
        },
        "classmap": ["classes/"],
        "exclude-from-classmap": ["classes/Excluded/"]
    },
    "autoload-dev": {
        "psr-4": {
            "Acme\\Shop\\Tests\\": "tests/"
        }
    }
}
