{
  "name": "@n-dx/web",
  "version": "0.5.0",
  "license": "Elastic-2.0",
  "description": "n-dx web dashboard — serves sourcevision, rex, and hench data",
  "repository": {
    "type": "git",
    "url": "https://github.com/en-dash-consulting/n-dx.git",
    "directory": "packages/web"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "n-dx-web": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/public.js",
      "types": "./dist/public.d.ts"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "build.js"
  ],
  "scripts": {
    "build": "tsc && node build.js",
    "build:viewer": "node build.js --viewer-only",
    "build:landing": "node build.js --landing-only",
    "dev": "node dev.js",
    "dev:viewer": "node build.js --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node ../../scripts/run-vitest-bind-aware.mjs web",
    "test:a11y": "vitest run --testNamePattern \"\\[a11y\\]\"",
    "test:watch": "vitest",
    "validate": "pnpm run typecheck && vitest run",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@n-dx/llm-client": "workspace:*",
    "@n-dx/rex": "workspace:*",
    "@n-dx/sourcevision": "workspace:*",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "preact": "^10.29.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/node": "^26.2.0",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
