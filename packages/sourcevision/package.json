{
  "name": "@n-dx/sourcevision",
  "version": "0.9.1",
  "license": "Elastic-2.0",
  "description": "Codebase analysis tool with structured, git-friendly output",
  "repository": {
    "type": "git",
    "url": "https://github.com/en-dash-consulting/n-dx.git",
    "directory": "packages/sourcevision"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "sourcevision": "./dist/cli/index.js",
    "sv": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/public.js",
      "types": "./dist/public.d.ts"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "src/language/queries",
    "build/grammars/*.wasm",
    "!dist/**/*.map",
    "!dist/.build-stamp.json"
  ],
  "scripts": {
    "build": "tsc && node ../../scripts/write-build-stamp.mjs",
    "build:grammars": "node ../lang-runtime/scripts/build-grammars.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-vitest-bind-aware.mjs sourcevision",
    "test:watch": "vitest",
    "test:update-goldens": "node scripts/update-pack-goldens.mjs",
    "validate": "tsc --noEmit && vitest run",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@n-dx/lang-kit": "workspace:*",
    "@n-dx/llm-client": "workspace:*",
    "ora": "^9.4.1",
    "pdfkit": "^0.20.2",
    "typescript": "^6.0.3",
    "web-tree-sitter": "0.27.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@n-dx/lang-go": "workspace:*"
  },
  "devDependencies": {
    "@n-dx/lang-java": "workspace:*",
    "@n-dx/lang-runtime": "workspace:*",
    "@n-dx/lang-sql": "workspace:*",
    "@n-dx/lang-terraform": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "jsdom": "^30.1.2",
    "vitest": "^5.0.4"
  }
}
