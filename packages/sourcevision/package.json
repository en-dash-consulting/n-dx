{
  "name": "@n-dx/sourcevision",
  "version": "0.5.1",
  "license": "Elastic-2.0",
  "description": "Codebase analysis tool with structured, git-friendly output",
  "repository": {
    "type": "git",
    "url": "https://github.com/en-dash-consulting/n-dx.git",
    "directory": "packages/sourcevision"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "sourcevision": "./dist/cli/index.js",
    "sv": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/public.js",
      "types": "./dist/public.d.ts"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-vitest-bind-aware.mjs sourcevision",
    "test:watch": "vitest",
    "validate": "tsc --noEmit && vitest run",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@n-dx/llm-client": "workspace:*",
    "ora": "^9.4.1",
    "pdfkit": "^0.19.1",
    "typescript": "^6.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pdfkit": "^0.17.6",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.10"
  }
}
