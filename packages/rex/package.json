{
  "name": "@n-dx/rex",
  "version": "0.9.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/en-dash-consulting/n-dx.git",
    "directory": "packages/rex"
  },
  "type": "module",
  "bin": {
    "rex": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/public.js",
      "types": "./dist/public.d.ts"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/.build-stamp.json"
  ],
  "scripts": {
    "build": "tsc && node ../../scripts/write-build-stamp.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest run --config vitest.bench.config.ts",
    "validate": "tsc --noEmit && vitest run",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@n-dx/llm-client": "workspace:*",
    "ora": "^9.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
