// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`rex MCP tools/list contract > returns an unchanged tool surface 1`] = `
"[
  {
    "name": "get_prd_status",
    "description": "Get PRD title, overall stats, and per-epic stats. Use to understand project scope and progress. On a v2 PRD: change counts over all changes, the Inbox count, product status per area and change counts per release (releases with open changes and the newest closed ones; allReleases lists every release).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "allReleases": {
          "description": "v2 only: list every release, not just those with open changes and the newest closed ones",
          "type": "boolean"
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "get_next_task",
    "description": "Get the next actionable task based on priority and dependencies, with explanation of why it was selected. Use when the user asks what to work on next.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tags": {
          "description": "Only return tasks that have at least one of these tags. Omit to return any task regardless of tags.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "update_task_status",
    "description": "Update the status of a PRD item. Use when starting work (in_progress), finishing (completed), or encountering blockers.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Item ID"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "in_progress",
            "completed",
            "failing",
            "deferred",
            "blocked",
            "cancelled",
            "deleted"
          ],
          "description": "New status"
        },
        "force": {
          "description": "Force the transition even if it violates transition rules (e.g. completed → pending)",
          "type": "boolean"
        },
        "reason": {
          "description": "Failure reason (used when status is 'failing')",
          "type": "string"
        },
        "resolutionType": {
          "description": "How the task was resolved (required when status is 'completed')",
          "type": "string",
          "enum": [
            "code-change",
            "config-override",
            "acknowledgment",
            "deferred",
            "unclassified"
          ]
        },
        "resolutionDetail": {
          "description": "Brief description of how the resolution was achieved",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "claim_task",
    "description": "Claim a task for this worktree so other worktrees' agents skip it. Use right after selecting a task, before planning or editing. Claims are released by update_task_status when the task reaches a terminal status, or by release_task.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Task ID to claim"
        }
      },
      "required": [
        "id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "release_task",
    "description": "Release this worktree's claim on a task without changing its status. Use when abandoning a task you claimed but did not finish.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Task ID to release"
        }
      },
      "required": [
        "id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "add_item",
    "description": "Add a new item to the PRD. Use when the user discusses a new feature, requirement, or work item that should be tracked. On a v2 PRD pass type (default change; a change that neither amends nor touches lands in the Inbox needing placement); on a v1 PRD pass level.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Item title"
        },
        "type": {
          "description": "v2: node type, default change. A task's parent is a change, a subtask's a task. On v1, task and subtask stand in for level",
          "type": "string",
          "enum": [
            "change",
            "task",
            "subtask"
          ]
        },
        "level": {
          "description": "v1 only: item level. Refused on a v2 PRD, which takes type",
          "type": "string",
          "enum": [
            "epic",
            "feature",
            "task",
            "subtask"
          ]
        },
        "parentId": {
          "description": "Parent item ID",
          "type": "string"
        },
        "description": {
          "description": "Item description (a v2 change's intent)",
          "type": "string"
        },
        "priority": {
          "description": "Priority",
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "acceptanceCriteria": {
          "description": "Acceptance criteria (done when) for this item's own work, changes included. Distinct from a capability's capability criteria",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "description": "Tags",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "description": "Source of this item",
          "type": "string"
        },
        "blockedBy": {
          "description": "IDs of blocking items",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "run": {
          "description": "Saved run settings for this item. Vendor-agnostic. Keys (all optional, unknown keys rejected): tier (light|standard|heavy), models ({claude?,codex?,google?,local?: model id} exact per-vendor pins), provider, permissionMode, review, reviewTier, reviewModels (same shape as models), reviewOptional, skipTestGate, maxTurns, tokenBudget, contextNotes.",
          "type": "object",
          "properties": {
            "tier": {
              "type": "string",
              "enum": [
                "light",
                "standard",
                "heavy"
              ]
            },
            "models": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "provider": {
              "type": "string",
              "enum": [
                "cli",
                "api"
              ]
            },
            "permissionMode": {
              "type": "string",
              "enum": [
                "default",
                "acceptEdits",
                "bypassPermissions"
              ]
            },
            "review": {
              "type": "boolean"
            },
            "reviewTier": {
              "type": "string",
              "enum": [
                "light",
                "standard",
                "heavy"
              ]
            },
            "reviewModels": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "reviewOptional": {
              "type": "boolean"
            },
            "skipTestGate": {
              "type": "boolean"
            },
            "maxTurns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "tokenBudget": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "contextNotes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "amends": {
          "description": "v2 change only: product-layer edits the change carries ({target, delta: added|modified|removed, summary, criteria?, proposed?, under?, title?, type?})",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "delta": {
                "type": "string",
                "enum": [
                  "added",
                  "modified",
                  "removed"
                ]
              },
              "summary": {
                "type": "string"
              },
              "criteria": {
                "type": "object",
                "properties": {
                  "add": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "text": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "text"
                      ],
                      "additionalProperties": {}
                    }
                  },
                  "replace": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "text": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "text"
                      ],
                      "additionalProperties": {}
                    }
                  },
                  "remove": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": {}
              },
              "proposed": {
                "type": "string"
              },
              "under": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "capability",
                  "constraint"
                ]
              },
              "base": {
                "type": "string"
              }
            },
            "required": [
              "target",
              "delta",
              "summary"
            ],
            "additionalProperties": {}
          }
        },
        "touches": {
          "description": "v2 change only: product node IDs the change works on without amending them",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "discoveredFrom": {
          "description": "v2 change only: {item?, run?}, the change or task (and hench run) whose work surfaced this one. Use it for a follow-up to a closed change",
          "type": "object",
          "properties": {
            "item": {
              "type": "string",
              "minLength": 1
            },
            "run": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "title"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "edit_item",
    "description": "Edit content fields of a PRD item (title, description, acceptance criteria, priority, level, tags, run). Use for content changes — use update_task_status for status/lifecycle transitions.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Item ID"
        },
        "title": {
          "description": "New title",
          "type": "string"
        },
        "description": {
          "description": "New description",
          "type": "string"
        },
        "acceptanceCriteria": {
          "description": "New acceptance criteria (done when) for this item's own work, changes included; replaces the list. Distinct from a capability's capability criteria",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priority": {
          "description": "New priority",
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "level": {
          "description": "New level (epic, feature, task, subtask)",
          "type": "string",
          "enum": [
            "epic",
            "feature",
            "task",
            "subtask"
          ]
        },
        "tags": {
          "description": "New tags",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "description": "New source",
          "type": "string"
        },
        "blockedBy": {
          "description": "New blocked-by IDs",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "run": {
          "description": "Saved run settings. An object REPLACES the whole block (omitted keys are dropped); null removes it. Vendor-agnostic keys: tier (light|standard|heavy), models ({claude?,codex?,google?,local?: model id}), provider, permissionMode, review, reviewTier, reviewModels, reviewOptional, skipTestGate, maxTurns, tokenBudget, contextNotes.",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "tier": {
                  "type": "string",
                  "enum": [
                    "light",
                    "standard",
                    "heavy"
                  ]
                },
                "models": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "provider": {
                  "type": "string",
                  "enum": [
                    "cli",
                    "api"
                  ]
                },
                "permissionMode": {
                  "type": "string",
                  "enum": [
                    "default",
                    "acceptEdits",
                    "bypassPermissions"
                  ]
                },
                "review": {
                  "type": "boolean"
                },
                "reviewTier": {
                  "type": "string",
                  "enum": [
                    "light",
                    "standard",
                    "heavy"
                  ]
                },
                "reviewModels": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "reviewOptional": {
                  "type": "boolean"
                },
                "skipTestGate": {
                  "type": "boolean"
                },
                "maxTurns": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 500
                },
                "tokenBudget": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "contextNotes": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "move_item",
    "description": "Move an item to a different parent in the PRD tree (reparent). Use to reorganize items that are under the wrong epic or feature.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Item ID to move"
        },
        "parentId": {
          "description": "New parent ID (omit to move to root)",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "merge_items",
    "description": "Consolidate multiple sibling items into one, combining descriptions, acceptance criteria, and tags. Use when duplicate or overlapping items are found.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IDs of items to merge (must be siblings at the same level)"
        },
        "targetId": {
          "type": "string",
          "description": "ID of the item that survives (must be in sourceIds)"
        },
        "preview": {
          "description": "If true, return a preview without executing the merge",
          "type": "boolean"
        },
        "title": {
          "description": "New title for the merged item (default: keep target's title)",
          "type": "string"
        },
        "description": {
          "description": "New description (default: combine all descriptions)",
          "type": "string"
        }
      },
      "required": [
        "sourceIds",
        "targetId"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "get_item",
    "description": "Get full details of a PRD item including parent chain. Use to understand task context before starting work.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Item ID"
        }
      },
      "required": [
        "id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "append_log",
    "description": "Append a structured log entry to the execution log",
    "inputSchema": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "description": "Event name"
        },
        "itemId": {
          "description": "Related item ID",
          "type": "string"
        },
        "detail": {
          "description": "Event details",
          "type": "string"
        }
      },
      "required": [
        "event"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "get_recommendations",
    "description": "Get SourceVision-based recommendations for PRD items. Use alongside get_findings for data-driven planning.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "verify_criteria",
    "description": "Map acceptance criteria to test files, and optionally run the repository's test command against them. Tests run only when runTests is true AND the repository's execution config is trusted (see \`ndx trust\`); the mapping is always returned.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "taskId": {
          "description": "Task ID to verify (omit for all tasks)",
          "type": "string"
        },
        "runTests": {
          "description": "Execute the test command from .rex/config.json (default: false). Ignored, with a note in the result, while the repository is not trusted.",
          "type": "boolean"
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "reorganize",
    "description": "Detect structural issues in the PRD and propose reorganizations (merge, move, delete, prune, collapse, split). Runs both programmatic detectors and LLM analysis by default.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "accept": {
          "description": "Apply proposals: 'low-risk' (default when set), 'all', or comma-separated IDs like '1,3'",
          "type": "string"
        },
        "includeCompleted": {
          "description": "Include completed items in similarity analysis (default: false)",
          "type": "boolean"
        },
        "mode": {
          "description": "Analysis mode: 'fast' (programmatic only) or 'full' (programmatic + LLM, default)",
          "type": "string",
          "enum": [
            "fast",
            "full"
          ]
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "health",
    "description": "Get structure health score with dimensional breakdown (depth, balance, granularity, completeness, staleness)",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "facets",
    "description": "List configured facets with distribution, or suggest facets for an item",
    "inputSchema": {
      "type": "object",
      "properties": {
        "itemId": {
          "description": "Item ID to get facet suggestions for (omit for overview)",
          "type": "string"
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "get_token_usage",
    "description": "Roll up hench run token usage and work duration across every PRD item. Returns \`{ tokens, duration }\` per item, where tokens is self+descendants+total counts and duration is { totalMs, runningMs, isRunning }. Completed subtrees report stable totalMs; running subtrees update on each call. Orphan runs (whose itemId is no longer in the PRD) are reported separately. Pass \`id\` to narrow to a single item.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Optional: only return rollup for this item",
          "type": "string"
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "get_capabilities",
    "description": "Get Rex server capabilities and configuration",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "get_product",
    "description": "Get the product layer of a v2 PRD: areas, and the capabilities and constraints under them, each with its computed status (proposed, changing, met, revised, retired) and health (ok, defective). Use get_capability for one node's detail.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "get_capability",
    "description": "Get one capability or constraint of a v2 PRD: its statement, capability criteria and requirements, parent chain, computed status and health, one page of the changes that amend or touch it (changeCounts covers all), the constraints that bind it, and the nodes changed alongside it. By default the changes are every open one plus the 10 most recently applied; use status, since and cursor (changesPage.nextCursor) to read more.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Capability or constraint id, display id (e.g. A1.2) or alias"
        },
        "status": {
          "description": "Which changes to list. Default recent: open plus the latest applied. all pages through the whole history",
          "type": "string",
          "enum": [
            "recent",
            "open",
            "applied",
            "all"
          ]
        },
        "since": {
          "description": "Only changes released (shippedIn, else plannedRelease) in this version or later, e.g. 1.2.0",
          "type": "string"
        },
        "cursor": {
          "description": "changesPage.nextCursor from the previous call, with the same status and since",
          "type": "string"
        },
        "limit": {
          "description": "Changes per page (default 25)",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "place_change",
    "description": "Place a v2 change on the product layer. Without target: returns the rules' shortlist of capabilities and constraints the change could amend or touch, best first, and the relation the rules chose. With target: records it (touches joins the change's touches; amends adds a modified amendment and needs proposed text or a criteria delta, or it is refused as apply_change would) and clears needsPlacement. Only an open change is placed.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Change id, display id (e.g. CH-12) or alias"
        },
        "target": {
          "description": "Capability or constraint to place the change on. Omit to get the shortlist without writing",
          "type": "string"
        },
        "relation": {
          "description": "With target: touches (works on it) or amends (edits its requirements). Default: the rules' relation",
          "type": "string",
          "enum": [
            "touches",
            "amends"
          ]
        },
        "summary": {
          "description": "With target and relation amends: the amendment's summary. Default: the change's title",
          "type": "string"
        },
        "proposed": {
          "description": "With target and relation amends: the target's replacement statement. Required with amends unless criteria is given",
          "type": "string"
        },
        "criteria": {
          "description": "With target and relation amends: capability criteria edits ({add?: [{id, text}], replace?: [{id, text}], remove?: [id]}). Required with amends unless proposed is given",
          "type": "object",
          "properties": {
            "add": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "text"
                ],
                "additionalProperties": {}
              }
            },
            "replace": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "text"
                ],
                "additionalProperties": {}
              }
            },
            "remove": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "apply_change",
    "description": "Apply an open v2 change's amendments to the product layer as a steward, whatever rex.applyOn says: added nodes are created, modified ones edited, removed ones retired, and the change is stamped appliedAt. The whole apply is refused, listing every problem, when an amendment does not fit or its target's spec moved since it was drafted (force overrides that last check).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Change id, display id (e.g. CH-12) or alias"
        },
        "force": {
          "description": "Apply amendments whose base no longer matches their target's spec",
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  }
]"
`;
