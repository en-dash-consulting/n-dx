{
  "schema": "hench/v1",
  "provider": "cli",
  "model": "opus",
  "permissionMode": "acceptEdits",
  "maxTurns": 50,
  "maxTokens": 8192,
  "rexDir": ".rex",
  "apiKeyEnv": "ANTHROPIC_API_KEY",
  "guard": {
    "blockedPaths": [
      ".hench/**",
      ".rex/**",
      ".git/**",
      "node_modules/**"
    ],
    "allowedCommands": [
      "npm",
      "npx",
      "node",
      "git",
      "tsc",
      "vitest"
    ],
    "commandTimeout": 30000,
    "maxFileSize": 1048576,
    "memoryThrottle": {
      "enabled": false
    }
  },
  "claudePath": "claude",
  "autoCommit": true,
  "livelockThreshold": 6,
  "maxFailedAttempts": 5,
  "retry": {
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "maxDelayMs": 30000
  }
}
