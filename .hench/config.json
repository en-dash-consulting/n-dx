{
  "schema": "hench/v1",
  "provider": "api",
  "model": "qwen/qwen3.5-9b",
  "permissionMode": "acceptEdits",
  "maxTurns": 150,
  "maxTokens": 8192,
  "rexDir": ".rex",
  "apiKeyEnv": "ANTHROPIC_API_KEY",
  "guard": {
    "blockedPaths": [
      ".hench/**",
      ".rex/**",
      ".git/**",
      "node_modules/**"
    ],
    "allowedCommands": [
      "npm",
      "npx",
      "node",
      "git",
      "tsc",
      "vitest"
    ],
    "commandTimeout": 3600000,
    "maxFileSize": 1048576,
    "memoryThrottle": {
      "enabled": false
    }
  },
  "claudePath": "claude",
  "autoCommit": true,
  "tokenBudget": 0
}
